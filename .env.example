DJANGO_DEBUG=true

# Local AI for spreadsheet column interpretation. No API key is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90

# Microsoft Entra application credentials. Never commit your populated .env file.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Configure the site and optionally the document-library name, or use the drive ID.
SHAREPOINT_SITE_ID=
SHAREPOINT_DOCUMENT_LIBRARY=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=Gastos/PorValidar

# Gateway Node.js (envio a Hacienda: simulador local)
GATEWAY_URL=http://127.0.0.1:3000
# Para probar desde el telefono: IP de tu PC separada por comas
DJANGO_ALLOWED_HOSTS=
